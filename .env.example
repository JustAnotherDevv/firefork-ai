# firefork environment variables. Copy to .env (gitignored) and fill in.

# Tigris (S3-compatible) for snapshot storage
AWS_ACCESS_KEY_ID=tid_replace_me
AWS_SECRET_ACCESS_KEY=tsec_replace_me
AWS_REGION=auto
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_BUCKET=firefork-snapshots

# Host paths (override defaults if your layout differs)
# FIREFORK_KERNEL=/var/lib/firefork/kernels/vmlinux-5.10.225
# FIREFORK_ROOTFS=/var/lib/firefork/rootfs/alpine-base.ext4
# FIREFORK_CACHE_DIR=/var/lib/firefork/cache
# FIREFORK_JAILER_ROOT=/srv/jailer/firecracker
